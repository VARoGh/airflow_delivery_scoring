# Минимальный .gitignore для ML/Airflow проекта

# Airflow / ML data (игнорируем содержимое, но не папки)
config/*
data/input/*
data/output/*
!data/input/.gitkeep
!data/output/.gitkeep
logs/*

plugins/*

!config/.gitkeep
!data/.gitkeep
!data/input/new_orders_20250220.csv
!logs/.gitkeep
!models/.gitkeep
!plugins/.gitkeep


# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.egg

# Виртуальные окружения
.env
.venv
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Системные файлы
.DS_Store
Thumbs.db

# Конфиденциальная информация
secrets.*
credentials.*
*.key
*.pem

# Прочие файлы
/docker-compose 3.yaml
/delivery_model.py
